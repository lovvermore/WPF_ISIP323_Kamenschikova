<Page x:Class="WPF_ISIP323_Kamenschikova.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_ISIP323_Kamenschikova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Введите логин:"/>
            <TextBox x:Name="LoginTextBox"/>
            <TextBlock Text="Введите пароль:"/>
            <PasswordBox x:Name="PasswordBox"/>
            <Button x:Name="AuthButton" Content ="Войти" Click="AuthButton_Click"/>
            <TextBlock Text="Если у Вас еще нет аккаунта, Вы можете:"/>
            <Button x:Name="RegistrationButton" Content ="Зврешистрироваться" Click="RegistrationButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
