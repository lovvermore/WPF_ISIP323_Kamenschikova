<Page x:Class="WPF_ISIP323_Kamenschikova.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_ISIP323_Kamenschikova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Придумайте логин:" Height="20" Width="130"/>
            <TextBox x:Name="UserLogin" Height="20" Width="200"/>
            <TextBlock Text="Придумайте пароль:" Height="20" Width="130"/>
            <PasswordBox x:Name="UserPassword" Height="20" Width="200"/>
            <TextBlock Text="Повторите пароль:" Height="20" Width="130"/>
            <PasswordBox x:Name="VerificatePassword" Height="20" Width="200"/>
            <Button x:Name="RegButton" Content="Зарегистрироваться" Margin="25" Width="200" Click="RegButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
